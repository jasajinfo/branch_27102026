# Credenciais exclusivas para laboratório local; altere para outros ambientes.
GATEWAY_PORT=3000
USERS_HOST=127.0.0.1
USERS_PORT=3001
ORDERS_HOST=127.0.0.1
ORDERS_PORT=3002
CORS_ORIGIN=http://localhost:5173
# O Docker mapeia a porta 15433; altere se estiver utilizando outro servidor PostgreSQL.
USERS_DATABASE_URL="postgresql://postgres:postgres@localhost:15433/users_db?schema=public"
ORDERS_DATABASE_URL="postgresql://postgres:postgres@localhost:15433/orders_db?schema=public"
NOTIFICATIONS_DATABASE_URL="postgresql://postgres:postgres@localhost:15433/notifications_db?schema=public"
# Banco exclusivo do catálogo DevFlix (Tutorial 04).
CATALOG_DATABASE_URL="postgresql://postgres:postgres@localhost:15433/catalog_db?schema=public"
# RabbitMQ: AMQP (5672) e painel (15672)
RABBITMQ_URL=amqp://app:app123@localhost:5672
RABBITMQ_NOTIFICATIONS_QUEUE=notifications_queue
